# Terraform working data and state (state may contain sensitive values)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ansible controller runtime data
.ansible/
*.retry

# Local credentials and environment overrides
.env
.env.*
!.env.example
*.vault-password

# Python-generated files
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime output from the future agent worker
runs/
worktrees/

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Accidental shell output file
=
