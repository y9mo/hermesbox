server {
    listen {{ localfi_artifact_bind_address }}:80;
    server_name {{ localfi_artifact_server_name }};

    root {{ localfi_artifact_root }}/current;
    index index.html;
    autoindex off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
