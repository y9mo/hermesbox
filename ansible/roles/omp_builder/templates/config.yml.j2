# Managed pilot overlay; inherited by native task children through PI_CONFIG_FILES.
modelRoles:
  default: {{ omp_builder_coordinator_model | to_json }}
  plan: {{ omp_builder_coordinator_model | to_json }}
  architect: {{ omp_builder_architect_model | to_json }}
  architect_astra: {{ omp_builder_architect_astra_model | to_json }}
  reviewer: {{ omp_builder_reviewer_model | to_json }}
  reviewer_astra: {{ omp_builder_reviewer_astra_model | to_json }}
  designer: {{ omp_builder_designer_model | to_json }}
  implementer: {{ omp_builder_implementer_model | to_json }}
  acceptance: {{ omp_builder_acceptance_model | to_json }}
  implementer_runinfra: {{ omp_builder_runinfra_implementer_model | to_json }}
  implementer_mistral: {{ omp_builder_mistral_implementer_model | to_json }}
  acceptance_runinfra: {{ omp_builder_runinfra_acceptance_model | to_json }}
  task: {{ omp_builder_implementer_model | to_json }}
  smol: {{ omp_builder_implementer_model | to_json }}
task:
  maxConcurrency: 2
  agentModelOverrides:
    architect: "@architect"
    architect-astra: "@architect_astra"
    implementer-openai: "@implementer"
    implementer-runinfra: "@implementer_runinfra"
    implementer-mistral: "@implementer_mistral"
    reviewer: "@reviewer"
    reviewer-astra: "@reviewer_astra"
    designer: "@designer"
    acceptance-deepseek: "@acceptance"
    acceptance-runinfra: "@acceptance_runinfra"
async:
  enabled: false
browser:
  enabled: true
